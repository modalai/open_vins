#!/usr/bin/env python3
"""Optional RealSense ROS 2 ingress; no Qt application required."""
from pathlib import Path
import sys

here = Path(__file__).resolve()
for root in (here.parent.parent / "src", here.parent.parent / "lib" / "zstudio",
             here.parent.parent / "lib64" / "zstudio"):
    if (root / "zstudio").is_dir():
        sys.path.insert(0, str(root))
        break
from zstudio.realsense_bridge import main

if __name__ == "__main__":
    main()
